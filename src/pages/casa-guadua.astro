---
import { Image } from 'astro:assets';
import Layout from '@/layouts/MainLayout.astro';
import Lightbox from '@/components/Lightbox.astro';

import guadua1 from '@/assets/img/proyectos/casa-guadua/guadua-1.jpg';
import guadua2 from '@/assets/img/proyectos/casa-guadua/guadua-2.jpg';
import guadua3 from '@/assets/img/proyectos/casa-guadua/guadua-3.jpg';
---

<Layout
  title="Casa Guadua — Apartaestudio Tropical en Bambú | LARQ Arquitectura"
  description="Casa Guadua es un apartaestudio tropical ligero y sostenible construido en bambú en Costa Rica. Diseño bioclimático con planos inclinados, estructuras expuestas y conexión total con el entorno natural. 2024."
  image={guadua1}
  type="article"
>

  <!-- HERO -->
  <section class="relative w-full h-screen overflow-hidden">
    <Image src={guadua1} widths={[768, 1280, 1920, 2560]} sizes="100vw" loading="eager" fetchpriority="high" alt="Casa Guadua" class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-[#3D3635]/25"></div>
    <a href="/projects-page" class="absolute top-6 left-6 md:top-10 md:left-10 flex items-center gap-2 text-white/80 hover:text-white text-xs tracking-[0.2em] uppercase transition-colors duration-300 group">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:-translate-x-1">
        <path d="M19 12H5M5 12l7 7M5 12l7-7"/>
      </svg>
      Proyectos
    </a>
    <div class="absolute bottom-10 left-6 md:bottom-14 md:left-12 lg:left-16">
      <p class="text-[#E2C200] text-[10px] md:text-xs font-medium tracking-[0.35em] uppercase mb-3">Residencial &nbsp;·&nbsp; Bioclimático</p>
      <h1 class="font-serif font-normal text-white text-5xl md:text-7xl lg:text-8xl leading-none tracking-tight">Casa Guadua</h1>
      <p class="text-white/50 text-xs md:text-sm mt-3 tracking-widest uppercase">Costa Rica &nbsp;·&nbsp; 2024</p>
    </div>
  </section>

  <!-- TEXTO -->
  <section class="bg-[#FAF7F2] py-20 md:py-28 lg:py-36">
    <div class="max-w-5xl mx-auto px-6 md:px-12 lg:px-16">
      <div class="flex items-center gap-4 mb-10 md:mb-14">
        <span class="block w-8 h-px bg-[#E2C200]"></span>
        <span class="text-[#E2C200] text-[10px] font-medium tracking-[0.4em] uppercase">El Proyecto</span>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-20 items-start">
        <h2 class="font-serif font-normal text-[#3D3635] text-3xl md:text-4xl lg:text-5xl leading-snug">
          Estructura ligera, integración natural con el entorno.
        </h2>
        <div class="space-y-5 text-[#3D3635]/70 text-sm md:text-base leading-relaxed lg:pt-2">
          <p>Casa Guadua es un apartaestudio tropical ligero y sostenible que se integra de manera armónica con su entorno. Construido principalmente en bambú, el proyecto explora sistemas estructurales eficientes que aprovechan la flexibilidad y resistencia natural del material, generando una estética orgánica y contemporánea.</p>
          <p>La composición se define por planos inclinados y estructuras expuestas que permiten una ventilación constante y una relación directa con el exterior. Los aleros amplios y la elevación del volumen protegen el espacio del clima, mientras que la vegetación circundante se incorpora como parte esencial de la experiencia.</p>
          <div class="pt-6 border-t border-[#3D3635]/10 grid grid-cols-2 gap-y-4 gap-x-8 text-xs">
            <div><p class="text-[#3D3635]/40 tracking-widest uppercase mb-1">Ubicación</p><p class="text-[#3D3635] font-medium">Costa Rica</p></div>
            <div><p class="text-[#3D3635]/40 tracking-widest uppercase mb-1">Año</p><p class="text-[#3D3635] font-medium">2024</p></div>
            <div><p class="text-[#3D3635]/40 tracking-widest uppercase mb-1">Tipología</p><p class="text-[#3D3635] font-medium">Residencial · Bioclimático</p></div>
            <div><p class="text-[#3D3635]/40 tracking-widest uppercase mb-1">Material</p><p class="text-[#3D3635] font-medium">Bambú / Guadua</p></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GALERÍA -->
  <section class="bg-[#FAF7F2] pb-24 md:pb-32 lg:pb-40">
    <div class="max-w-7xl mx-auto px-4 md:px-8 space-y-2 md:space-y-3">

      <!-- Fila 1: dos columnas iguales -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 md:gap-3">
        <div class="overflow-hidden">
          <Image src={guadua2} widths={[640, 1024, 1600, 2400]} sizes="(min-width: 640px) 50vw, 100vw" alt="Casa Guadua — Vista 2" data-lightbox
            class="w-full h-[50vw] sm:h-[50vh] md:h-[55vh] object-cover hover:scale-[1.02] transition-transform duration-700 cursor-zoom-in" />
        </div>
        <div class="overflow-hidden">
          <Image src={guadua3} widths={[640, 1024, 1600, 2400]} sizes="(min-width: 640px) 50vw, 100vw" alt="Casa Guadua — Vista 3" data-lightbox
            class="w-full h-[50vw] sm:h-[50vh] md:h-[55vh] object-cover hover:scale-[1.02] transition-transform duration-700 cursor-zoom-in" />
        </div>
      </div>

      <!-- Fila 2: full-width -->
      <div class="overflow-hidden">
        <Image src={guadua1} widths={[640, 1024, 1600, 2400]} sizes="100vw" alt="Casa Guadua — Vista panorámica" data-lightbox
          class="w-full h-[45vw] md:h-[55vh] object-cover object-bottom hover:scale-[1.02] transition-transform duration-700 cursor-zoom-in"
          style="min-height: 200px;" />
      </div>

    </div>
  </section>

  <!-- FOOTER CTA -->
  <section class="bg-[#3D3635] py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-6 md:px-12 flex flex-col sm:flex-row items-center justify-between gap-6">
      <p class="font-serif font-normal text-white/60 text-lg md:text-xl italic">¿Tienes un proyecto en mente?</p>
      <div class="flex items-center gap-6">
        <a href="/projects-page" class="text-white/50 hover:text-white text-xs tracking-[0.25em] uppercase transition-colors duration-200">Ver todos los proyectos</a>
        <a href="/contact" class="px-6 py-3 bg-[#E2C200] text-white text-xs tracking-[0.2em] uppercase font-medium hover:bg-[#c9ac00] transition-colors duration-200">Conversemos</a>
      </div>
    </div>
  </section>

  <Lightbox />

</Layout>
